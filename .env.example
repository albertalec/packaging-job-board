# Public site URL (Stripe redirects, sitemap, canonical). Set to https://{domain} in production.
SITE_URL=http://localhost:3000

# Brand — set when the final name and custom domain are chosen (see PLAN.md §1d).
# Use NEXT_PUBLIC_* copies in Vercel so client components (masthead) pick them up at build time.
SITE_NAME=Packaging Job Board
NEXT_PUBLIC_SITE_NAME=Packaging Job Board
SITE_DOMAIN=packagingjobboard.com
NEXT_PUBLIC_SITE_DOMAIN=packagingjobboard.com
CONTACT_EMAIL=hello@packagingjobboard.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@packagingjobboard.com
# Optional masthead split (defaults: first/second half of SITE_NAME)
# SITE_MARK_LINES=Package Dev|Jobs
# NEXT_PUBLIC_SITE_MARK_LINE_1=Package Dev
# NEXT_PUBLIC_SITE_MARK_LINE_2=Jobs

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: persist sponsorships on Vercel (filesystem is read-only in production)
# Create a Blob store in the Vercel project → Storage → Blob
BLOB_READ_WRITE_TOKEN=
