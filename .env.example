# Public site URL fallback when Host is missing (local sitemap/dev).
# Production resolves origin from the request host + tenant config.
SITE_URL=http://localhost:3000

# Local tenant: localhost and *.vercel.app default to packaging.
# Preview the parent hub with:
#   TENANT_HOST=nicheboard.com
# or open http://nicheboard.localhost:3000
# DEFAULT_VERTICAL=packaging
# TENANT_HOST=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: persist sponsorships on Vercel (filesystem is read-only in production)
# Create a Blob store in the Vercel project → Storage → Blob
BLOB_READ_WRITE_TOKEN=
