# Public site URL fallback when Host is missing (local sitemap/dev).
# Production resolves origin from the request host + tenant config.
SITE_URL=http://localhost:3000

# Local tenant: localhost and *.vercel.app default to packaging.
# Preview the parent hub with:
#   TENANT_HOST=nicheboardjobs.com
# or open http://nicheboard.localhost:3000
# DEFAULT_VERTICAL=packaging
# TENANT_HOST=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Upstash Redis — persists sponsorships + job-alert subscribers in production.
# Create a free database at https://console.upstash.com → Redis → Create.
# Copy REST URL + token into Vercel env (Production + Preview), then redeploy.
# Locally, omit these to use data/sponsorships and data/alerts JSON files.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free job alerts (Resend). Without RESEND_API_KEY, subscribe still works
# in local/dev but confirmation/digest emails are skipped (logged).
# RESEND_API_KEY=re_...
# ALERTS_FROM_EMAIL=alerts@nicheboardjobs.com
# Display name defaults to tenant alertsFromName (e.g. Packaging Jobs Alerts).
# Or set the full From header: Packaging Jobs Alerts <alerts@nicheboardjobs.com>
# ALERTS_CRON_SECRET=long-random-string
# Vercel Cron also sends Authorization: Bearer $CRON_SECRET when set.

# Analytics: Vercel Web Analytics (no env var). Enable in the Vercel project:
# Analytics → Enable. Apply clicks send a custom "Apply" event.

# Google Search Console — HTML tag method (preferred; no DNS required).
# In GSC choose "HTML tag", copy only the content="…" token (not the full tag).
# GOOGLE_SITE_VERIFICATION_PACKAGING=token-for-packaging.nicheboardjobs.com
# GOOGLE_SITE_VERIFICATION_HUB=token-for-nicheboardjobs.com
